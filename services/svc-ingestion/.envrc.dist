# Server
EDIFACT_SERVER_PORT=8080

# Database
EDIFACT_DB_HOST=postgres
EDIFACT_DB_PORT=5432
EDIFACT_DB_USER=ingestion
EDIFACT_DB_PASSWORD=ingestion
EDIFACT_DB_NAME=ingestion
EDIFACT_DB_SSLMODE=disable
EDIFACT_DB_POOL_SIZE=20

# Kafka
EDIFACT_KAFKA_BROKERS=kafka:9092
EDIFACT_KAFKA_TOPIC=edifact.events

# Logging
EDIFACT_LOG_LEVEL=info
EDIFACT_LOG_FORMAT=json

# OpenTelemetry
EDIFACT_OTEL_ENDPOINT=jaeger:4317
EDIFACT_OTEL_SERVICE_NAME=svc-ingestion
EDIFACT_OTEL_ENABLED=true
