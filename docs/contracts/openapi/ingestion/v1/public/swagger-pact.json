{
  "openapi": "3.0.3",
  "info": {
    "title": "EDIFACT Ingestion API",
    "version": "1.0.0",
    "description": "Ingestion system for incoming EDIFACT messages in the German electricity retail market. Accepts files, parses into individual messages, persists structured data, and supports versioned reprocessing.\n",
    "contact": {
      "name": "Nomos Technical Challenge"
    }
  },
  "servers": [
    {
      "url": "http://api.ingestion.dev/v1",
      "description": "Local development (via Traefik)"
    }
  ],
  "paths": {
    "/interchanges": {
      "post": {
        "operationId": "ingestFile",
        "summary": "Ingest an EDIFACT file",
        "description": "Synchronously parses and persists the submitted EDIFACT file. Returns the full result (interchange ID, final status, message summary) in a single response. Idempotent — resubmission of an existing file (same SHA-256) returns the same result without reprocessing.\n",
        "tags": [
          "Interchanges"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "EDIFACT file content. Maximum size: 10 MB (10,485,760 bytes)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File already ingested (idempotent re-submission)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ingest"
                }
              }
            }
          },
          "201": {
            "description": "File successfully ingested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ingest"
                }
              }
            }
          },
          "413": {
            "description": "File exceeds the 10 MB size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "422": {
            "description": "File failed structural validation (missing UNB/UNZ envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/server-error"
          }
        }
      }
    },
    "/interchanges/reprocess": {
      "post": {
        "operationId": "reprocessInterchanges",
        "summary": "Bulk reprocess interchanges by filter",
        "description": "Re-parses all interchanges matching the filter criteria using current parsing rules, creating a new processing version for each. Returns a summary of results synchronously. Zero matches returns a zero-count summary, not an error.\n",
        "tags": [
          "Interchanges"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/reprocess-filter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reprocessing completed (including partial failures)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/reprocess-result"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/bad-request"
          },
          "500": {
            "$ref": "#/components/responses/server-error"
          }
        }
      }
    },
    "/interchanges/{id}": {
      "get": {
        "operationId": "getInterchange",
        "summary": "Retrieve an interchange by ID",
        "description": "Returns interchange metadata, the active processing version, and message count summary.\n",
        "tags": [
          "Interchanges"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/InterchangeId"
          }
        ],
        "responses": {
          "200": {
            "description": "Interchange found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/interchange-detail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not-found"
          },
          "500": {
            "$ref": "#/components/responses/server-error"
          }
        }
      }
    },
    "/interchanges/{id}/raw": {
      "get": {
        "operationId": "getRawFile",
        "summary": "Download the original EDIFACT file content",
        "description": "Returns the raw, unmodified EDIFACT bytes that were originally submitted.\n",
        "tags": [
          "Interchanges"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/InterchangeId"
          }
        ],
        "responses": {
          "200": {
            "description": "Raw EDIFACT file content",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not-found"
          },
          "500": {
            "$ref": "#/components/responses/server-error"
          }
        }
      }
    },
    "/interchanges/{id}/rollback": {
      "post": {
        "operationId": "rollbackVersion",
        "summary": "Roll back to a previous processing version",
        "description": "Restores the specified processing version as the active one without deleting the current version. Emits a version.rolled_back domain event.\n",
        "tags": [
          "Interchanges"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/InterchangeId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rollback-request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rollback completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/rollback-response"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not-found"
          },
          "409": {
            "description": "Target version does not exist for this interchange",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/server-error"
          }
        }
      }
    },
    "/messages": {
      "get": {
        "operationId": "listMessages",
        "summary": "List parsed messages with filtering",
        "description": "Returns messages from the active processing version by default. Filter by subscription identifier, message type, interchange ID, or processing version ID. Supports cursor-based pagination.\n",
        "tags": [
          "Messages"
        ],
        "parameters": [
          {
            "name": "subscription_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "message_type",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "MSCONS"
            }
          },
          {
            "name": "interchange_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "processing_version_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Opaque base64url-encoded cursor from the next_cursor field of a previous response. Omit on first page.\n"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/message-list"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/bad-request"
          },
          "500": {
            "$ref": "#/components/responses/server-error"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Combined health status",
        "description": "Reports liveness and readiness including dependency connectivity.",
        "tags": [
          "System"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/health"
                }
              }
            }
          },
          "503": {
            "description": "One or more dependencies unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/health"
                }
              }
            }
          }
        }
      }
    },
    "/liveness": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Liveness probe",
        "description": "Returns 200 if the process is alive.",
        "tags": [
          "System"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive"
          },
          "503": {
            "description": "Process should be restarted"
          }
        }
      }
    },
    "/readiness": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Readiness probe",
        "description": "Returns 200 when PostgreSQL and Kafka connections are established.",
        "tags": [
          "System"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Ready to serve traffic"
          },
          "503": {
            "description": "Not ready (dependency unavailable)"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "InterchangeId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Interchange UUID"
      }
    },
    "responses": {
      "NotFound": {
        "$ref": "#/components/responses/not-found"
      },
      "BadRequest": {
        "$ref": "#/components/responses/bad-request"
      },
      "InternalError": {
        "$ref": "#/components/responses/server-error"
      },
      "server-error": {
        "description": "Unexpected internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/error"
            }
          }
        }
      },
      "bad-request": {
        "description": "Invalid request body or parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/error"
            }
          }
        }
      },
      "not-found": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/error"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "$ref": "#/components/schemas/error"
      },
      "IngestResponse": {
        "$ref": "#/components/schemas/ingest"
      },
      "MessageSummary": {
        "$ref": "#/components/schemas/message-summary"
      },
      "InterchangeDetail": {
        "$ref": "#/components/schemas/interchange-detail"
      },
      "ProcessingVersionSummary": {
        "$ref": "#/components/schemas/processing-version-summary"
      },
      "ReprocessFilter": {
        "$ref": "#/components/schemas/reprocess-filter"
      },
      "ReprocessResult": {
        "$ref": "#/components/schemas/reprocess-result"
      },
      "ReprocessFailure": {
        "$ref": "#/components/schemas/reprocess-failure"
      },
      "RollbackRequest": {
        "$ref": "#/components/schemas/rollback-request"
      },
      "RollbackResponse": {
        "$ref": "#/components/schemas/rollback-response"
      },
      "MessageList": {
        "$ref": "#/components/schemas/message-list"
      },
      "Message": {
        "$ref": "#/components/schemas/message"
      },
      "HealthResponse": {
        "$ref": "#/components/schemas/health"
      },
      "message-summary": {
        "type": "object",
        "required": [
          "total",
          "by_type"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "by_type": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "example": {
              "MSCONS": 3,
              "INVOIC": 1
            }
          }
        }
      },
      "ingest": {
        "type": "object",
        "required": [
          "interchange_id",
          "status",
          "message_summary"
        ],
        "properties": {
          "interchange_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ]
          },
          "error_detail": {
            "type": "string",
            "nullable": true,
            "description": "Populated only when status = failed"
          },
          "message_summary": {
            "$ref": "#/components/schemas/message-summary"
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FILE_TOO_LARGE",
              "INVALID_EDIFACT",
              "DUPLICATE_DETECTED",
              "NOT_FOUND",
              "CONFLICT",
              "BAD_REQUEST",
              "INTERNAL_ERROR"
            ],
            "description": "Machine-readable error code"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description"
          },
          "correlation_id": {
            "type": "string",
            "description": "X-Correlation-ID from request headers"
          }
        }
      },
      "reprocess-filter": {
        "type": "object",
        "description": "At least one filter field should be provided. Omitting all fields matches all interchanges (full corpus reprocessing).\n",
        "properties": {
          "interchange_id": {
            "type": "string",
            "format": "uuid",
            "description": "Reprocess a single interchange"
          },
          "sender_id": {
            "type": "string",
            "description": "Reprocess all interchanges from this sender"
          },
          "message_type": {
            "type": "string",
            "description": "Reprocess interchanges containing this message type"
          },
          "from_date": {
            "type": "string",
            "format": "date",
            "description": "Reprocess interchanges prepared on or after this date"
          },
          "to_date": {
            "type": "string",
            "format": "date",
            "description": "Reprocess interchanges prepared on or before this date"
          }
        }
      },
      "reprocess-failure": {
        "type": "object",
        "required": [
          "interchange_id",
          "reason"
        ],
        "properties": {
          "interchange_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "reprocess-result": {
        "type": "object",
        "required": [
          "matched",
          "succeeded",
          "failed"
        ],
        "properties": {
          "matched": {
            "type": "integer",
            "description": "Number of interchanges matching the filter"
          },
          "succeeded": {
            "type": "integer",
            "description": "Number successfully reprocessed"
          },
          "failed": {
            "type": "integer",
            "description": "Number that failed during reprocessing"
          },
          "failures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/reprocess-failure"
            }
          }
        }
      },
      "processing-version-summary": {
        "type": "object",
        "required": [
          "id",
          "version_number",
          "parser_version",
          "format_version",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version_number": {
            "type": "integer"
          },
          "parser_version": {
            "type": "string"
          },
          "format_version": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "interchange-detail": {
        "type": "object",
        "required": [
          "id",
          "sender_id",
          "receiver_id",
          "prepared_at",
          "reference",
          "status",
          "created_at",
          "active_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sender_id": {
            "type": "string"
          },
          "sender_qualifier": {
            "type": "string"
          },
          "receiver_id": {
            "type": "string"
          },
          "receiver_qualifier": {
            "type": "string"
          },
          "prepared_at": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ]
          },
          "error_detail": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "active_version": {
            "$ref": "#/components/schemas/processing-version-summary"
          },
          "message_summary": {
            "description": "Present when status = completed.",
            "$ref": "#/components/schemas/message-summary"
          }
        }
      },
      "rollback-request": {
        "type": "object",
        "required": [
          "version_number"
        ],
        "properties": {
          "version_number": {
            "type": "integer",
            "minimum": 1,
            "description": "The version number to restore as active"
          }
        }
      },
      "rollback-response": {
        "type": "object",
        "required": [
          "interchange_id",
          "active_version_number"
        ],
        "properties": {
          "interchange_id": {
            "type": "string",
            "format": "uuid"
          },
          "active_version_number": {
            "type": "integer",
            "description": "The version number now active after rollback"
          }
        }
      },
      "message": {
        "type": "object",
        "required": [
          "id",
          "interchange_id",
          "processing_version_id",
          "message_type",
          "message_reference",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "interchange_id": {
            "type": "string",
            "format": "uuid"
          },
          "processing_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "subscription_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "message_type": {
            "type": "string",
            "example": "MSCONS"
          },
          "message_reference": {
            "type": "string"
          },
          "segments": {
            "type": "object",
            "additionalProperties": true,
            "description": "Full parsed segment tree (JSONB)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "message-list": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/message"
            }
          },
          "total": {
            "type": "integer"
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "health": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "postgres": {
                "type": "string",
                "enum": [
                  "ok",
                  "error"
                ]
              },
              "kafka": {
                "type": "string",
                "enum": [
                  "ok",
                  "error"
                ]
              }
            }
          }
        }
      }
    }
  }
}